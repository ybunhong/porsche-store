{
  "extends": ["airbnb-base", "plugin:lit/recommended"],
  "plugins": ["lit"],
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "rules": {
    "import/no-extraneous-dependencies": [
      "error",
      {
        "devDependencies": ["vite.config.js"]
      }
    ],
    "no-console": "warn",
    "no-undef": "error",
    "quotes": ["error", "double"],
    "semi": ["error", "always"],
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "object-curly-spacing": ["error", "always"],
    "arrow-body-style": ["error", "as-needed"],
    "import/prefer-default-export": "off",
    "import/extensions": "off",
    "camelcase": ["error", { "properties": "always" }],
    "id-match": [
      "error",
      "^[a-z][a-zA-Z0-9]*$|^[A-Z][a-zA-Z0-9]*$",
      {
        "onlyDeclarations": true
      }
    ],
    "lit/no-invalid-html": "error", // catches invalid HTML
    "lit/no-unclosed-tags": "error", // enforces tag-pairs
    "lit/attribute-value-entities": "error", // ensures special chars like `&` are escaped
    "lit/no-duplicate-template-bindings": "error", // prevents duplicate bindings
    "lit/no-property-change-update": "error"
  }
}
